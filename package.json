{
  "name": "dsh-foresight",
  "version": "0.1.0",
  "description": "DeepSeek Harness 输入框增强：回合结束后预测你的下一句（灰字，Tab 采纳），输入时按会话历史补全，每轮结束追加一行回顾，并支持 ↑/↓ 召回历史提示词。",
  "author": "overFloweee",
  "license": "MIT",
  "type": "module",
  "icon": "./icon.svg",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "icon.svg",
    "lib",
    "docs",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE",
    "NOTICE.md"
  ],
  "screenshots": [
    {
      "src": "./docs/preview-ghost-style.png",
      "label": "幽灵文本样式预览（深色 / 浅色主题；模型预测、历史补全、换行）"
    }
  ],
  "engines": {
    "node": "^22.19 || >=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:smoke": "node scripts/module-id-smoke.mjs && node scripts/isolation-smoke.mjs && node --experimental-strip-types scripts/history-smoke.mjs && node --experimental-strip-types scripts/sanitize-smoke.mjs && node --experimental-strip-types scripts/hotness-persist-smoke.mjs && node --experimental-strip-types scripts/coldstart-smoke.mjs && node scripts/transcript-filter-smoke.mjs && node scripts/ghost-geom-smoke.mjs && node scripts/prediction-source-smoke.mjs",
    "test:e2e": "pnpm build && node scripts/reasoning-effort-e2e.mjs && node scripts/hotness-persist-e2e.mjs && node scripts/prediction-slice1-e2e.mjs && node scripts/prediction-slice2-e2e.mjs && node scripts/prediction-client-e2e.mjs && node scripts/coldstart-e2e.mjs && node scripts/recap-e2e.mjs",
    "preview": "node scripts/preview-card.mjs",
    "replay": "node --experimental-strip-types scripts/replay-history.mjs",
    "test": "node --test tests/*.test.mjs",
    "probe:host": "node scripts/probe-host.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/cosmokit": "^1.8.5",
    "@deepseek-ai/dsh-llm": "^0.1.1-rc.2 || ^0.1.2-rc.1 || ^0.1.5-rc.1 || ^0.1.7-rc.2 || ^0.2.0-rc.2",
    "@deepseek-ai/dsh-session": "^0.1.1-rc.2 || ^0.1.2-rc.1 || ^0.1.5-rc.1 || ^0.1.7-rc.2 || ^0.2.0-rc.2",
    "@deepseek-ai/dsh-session-projection": "^0.1.1-rc.2 || ^0.1.2-rc.1 || ^0.1.5-rc.1 || ^0.1.7-rc.2 || ^0.2.0-rc.2",
    "@deepseek-ai/dsh-settings": "^0.1.1-rc.2 || ^0.1.2-rc.1 || ^0.1.5-rc.1 || ^0.1.7-rc.2 || ^0.2.0-rc.2",
    "@deepseek-ai/dsh-storage-domain": "^0.1.1-rc.2 || ^0.1.2-rc.1 || ^0.1.5-rc.1 || ^0.1.7-rc.2 || ^0.2.0-rc.2",
    "@deepseek-ai/dsh-timeout": "^0.1.1-rc.2 || ^0.1.2-rc.1 || ^0.1.5-rc.1 || ^0.1.7-rc.2 || ^0.2.0-rc.2",
    "@deepseek-ai/schemastery": "^3.18.3",
    "zod": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-storage-domain": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/cosmokit": "^1.8.5",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session-projection": "0.2.0-rc.2",
    "@deepseek-ai/dsh-settings": "0.2.0-rc.2",
    "@deepseek-ai/dsh-storage": "0.2.0-rc.2",
    "@deepseek-ai/dsh-storage-domain": "0.2.0-rc.2",
    "@deepseek-ai/dsh-storage-json": "0.2.0-rc.2",
    "@deepseek-ai/dsh-timeout": "0.2.0-rc.2",
    "@deepseek-ai/schemastery": "^3.18.4",
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "^5.9.0",
    "zod": "^4.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "contributors": [
    "WuJiaoJue (dsh-suggest-ghost 原作者)"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/overFloweee/dsh-foresight.git"
  },
  "homepage": "https://github.com/overFloweee/dsh-foresight",
  "bugs": {
    "url": "https://github.com/overFloweee/dsh-foresight/issues"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "input-prediction",
    "autocomplete",
    "prompt-history",
    "recap"
  ]
}
